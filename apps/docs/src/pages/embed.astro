---
// Chrome-free showcase for iframes, e.g. on amitpatjoshi.com:
// <iframe src="https://amitpatjoshidesign.github.io/tablekit/embed/?recipe=invoices&theme=light" …>
import "@fontsource-variable/inter";
import "@tablekit/react/styles.css";
import "../styles/site.css";
import Embed from "../components/Embed";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>tablekit demo</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const q = new URLSearchParams(location.search).get("theme");
        const t = q === "light" || q === "dark" ? q : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.classList.add(t);
      })();
    </script>
    <style is:global>
      body { padding: 0; background: transparent; }
      .demo { margin: 0; }
    </style>
  </head>
  <body>
    <Embed client:only="react" />
  </body>
</html>
