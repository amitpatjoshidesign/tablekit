{
  "name": "@tablekit/tokens",
  "version": "0.1.0",
  "description": "Design tokens for tablekit as CSS custom properties and W3C DTCG JSON, plus presets for shadcn/ui, Material 3, Carbon and Radix.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
