    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "css-variables",
    "table",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitpatjoshidesign/tablekit.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://amitpatjoshidesign.github.io/tablekit/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
